# Sao chép thành .env rồi điền giá trị. KHÔNG commit file .env.

# ---------- Chung ----------
AGRI_SITE=farm-a
DD_ENV=demo
LOG_LEVEL=INFO
# Token cho các thao tác ghi trên web (điều khiển, cài đặt, xử lý sự cố). Để trống = không cần token.
ADMIN_TOKEN=
# Khi chạy sau reverse proxy ở đường dẫn con, vd. https://synsen.net/agriguard/
ROOT_PATH=

# Cổng mở ra máy host. Đổi nếu máy đã có dịch vụ khác dùng 8000 / 1883.
BACKEND_PORT=8000
# VPS: 127.0.0.1 để cổng 8000 không lộ ra Internet (web đi qua Caddy HTTPS)
BACKEND_BIND=0.0.0.0
# VPS: tên miền cho Caddy cấp HTTPS, vd. api.synsen.net hoặc 1-2-3-4.sslip.io
API_DOMAIN=
MQTT_PUBLIC_PORT=1883

# ---------- MongoDB ----------
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Local:  mongodb://mongo:27017   (chạy kèm --profile local-mongo)
# Thử nhanh không cần CSDL: memory://   (cần mongomock, dữ liệu mất khi tắt)
MONGODB_URI=mongodb://mongo:27017
MONGODB_DB=agriguard
TELEMETRY_TTL_DAYS=30
FORECAST_TTL_DAYS=3            # dự báo AI (collection forecasts) tự xoá sau 3 ngày
AI_INTERVAL_S=60               # vòng AI: học lại / lập kế hoạch / đối chiếu dự báo

# ---- Nhận cảnh báo Datadog ngoài web (monitor gắn tag notify:yes) ----
# Email: điền địa chỉ dạng "@ban@gmail.com" (nhiều địa chỉ cách nhau dấu cách), rồi chạy lại datadog/bootstrap.py apply
DD_NOTIFY_HANDLES=
# Zalo: tạo bot tại bot.zaloplatforms.com, nhắn bot 1 tin, lấy chat_id bằng: python -m app.notify zalo-chat-id
ZALO_BOT_TOKEN=
ZALO_CHAT_ID=
# WhatsApp (CallMeBot): nhắn "I allow callmebot to send me messages" tới bot để nhận apikey; số dạng +849...
CALLMEBOT_PHONE=
CALLMEBOT_APIKEY=

# ---------- MQTT (Mosquitto) ----------
# Để trống MQTT_PASSWORD = broker cho phép ẩn danh (chỉ dùng trong LAN).
MQTT_USER=agriguard
MQTT_PASSWORD=

# ---------- Datadog ----------
# Bật sau khi có tài khoản (dự kiến 26/10): METRICS_ENABLED=true, DD_TRACE_ENABLED=true
# và chạy: docker compose --profile datadog up -d
DD_API_KEY=
DD_APP_KEY=
# Site của tài khoản: datadoghq.com (US1), us3.datadoghq.com, us5.datadoghq.com, datadoghq.eu, ap1.datadoghq.com
DD_SITE=datadoghq.com
METRICS_ENABLED=false
DD_TRACE_ENABLED=false
# RUM cho web: Digital Experience → Add an Application → JS. Để trống = tắt RUM.
DD_RUM_APPLICATION_ID=
DD_RUM_CLIENT_TOKEN=
DD_RUM_SESSION_SAMPLE=100
DD_RUM_REPLAY_SAMPLE=0
# Token bí mật gắn vào URL webhook mà Datadog gọi về backend
DATADOG_WEBHOOK_TOKEN=change-me-long-random-string
# URL công khai của backend để Datadog gọi webhook, vd. https://synsen.net/agriguard
PUBLIC_BASE_URL=

# ---------- Bộ giả lập ----------
SIM_DEVICES=2
SIM_DAY_MINUTES=30
ENABLE_SIM_API=true

# ---------- Thời gian kiểm chứng sự cố (giây) ----------
VERIFY_MIST_SECONDS=120
VERIFY_GENERIC_SECONDS=30
