# Sao chép thành .env rồi điền giá trị. KHÔNG commit file .env.

# ---------- Chung ----------
AGRI_SITE=farm-a
DD_ENV=demo
LOG_LEVEL=INFO
# Token cho các thao tác ghi trên web (điều khiển, cài đặt, xử lý sự cố). Để trống = không cần token.
ADMIN_TOKEN=
# Khi chạy sau reverse proxy ở đường dẫn con, vd. https://synsen.net/agriguard/
ROOT_PATH=

# ---------- MongoDB ----------
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Local:  mongodb://mongo:27017   (chạy kèm --profile local-mongo)
# Thử nhanh không cần CSDL: memory://   (cần mongomock, dữ liệu mất khi tắt)
MONGODB_URI=mongodb://mongo:27017
MONGODB_DB=agriguard
TELEMETRY_TTL_DAYS=30

# ---------- MQTT (Mosquitto) ----------
# Để trống MQTT_PASSWORD = broker cho phép ẩn danh (chỉ dùng trong LAN).
MQTT_USER=agriguard
MQTT_PASSWORD=

# ---------- Datadog ----------
# Bật sau khi có tài khoản (dự kiến 26/10): METRICS_ENABLED=true, DD_TRACE_ENABLED=true
# và chạy: docker compose --profile datadog up -d
DD_API_KEY=
DD_APP_KEY=
# Site của tài khoản: datadoghq.com (US1), us3.datadoghq.com, us5.datadoghq.com, datadoghq.eu, ap1.datadoghq.com
DD_SITE=datadoghq.com
METRICS_ENABLED=false
DD_TRACE_ENABLED=false
# Token bí mật gắn vào URL webhook mà Datadog gọi về backend
DATADOG_WEBHOOK_TOKEN=change-me-long-random-string
# URL công khai của backend để Datadog gọi webhook, vd. https://synsen.net/agriguard
PUBLIC_BASE_URL=

# ---------- Bộ giả lập ----------
SIM_DEVICES=2
SIM_DAY_MINUTES=30
ENABLE_SIM_API=true

# ---------- Thời gian kiểm chứng sự cố (giây) ----------
VERIFY_PUMP_SECONDS=45
VERIFY_MIST_SECONDS=120
VERIFY_GENERIC_SECONDS=30
