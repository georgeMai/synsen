{
  "title": "AgriGuard – IoT Irrigation Operations",
  "description": "Giám sát thời gian thực hệ thống tưới AgriGuard (ESP32 → MQTT → FastAPI → MongoDB). Dashboard được tạo bởi datadog/bootstrap.py.",
  "layout_type": "ordered",
  "template_variables": [
    {
      "name": "device_id",
      "prefix": "device_id",
      "default": "*"
    }
  ],
  "widgets": [
    {
      "definition": {
        "type": "group",
        "title": "Tổng quan",
        "layout_type": "ordered",
        "widgets": [
          {
            "definition": {
              "type": "query_value",
              "title": "Thiết bị online",
              "precision": 0,
              "autoscale": true,
              "requests": [
                {
                  "q": "sum:agriguard.device.online{*}",
                  "aggregator": "last"
                }
              ]
            }
          },
          {
            "definition": {
              "type": "query_value",
              "title": "Sự cố đang mở",
              "precision": 0,
              "autoscale": true,
              "requests": [
                {
                  "q": "sum:agriguard.incident.open{*}",
                  "aggregator": "last"
                }
              ]
            }
          },
          {
            "definition": {
              "type": "query_value",
              "title": "Ingest p95 (ms)",
              "precision": 0,
              "autoscale": true,
              "requests": [
                {
                  "q": "avg:agriguard.ingest.latency_ms.95percentile{*}",
                  "aggregator": "avg"
                }
              ],
              "custom_unit": "ms"
            }
          },
          {
            "definition": {
              "type": "query_value",
              "title": "Ack lệnh p95 (ms)",
              "precision": 0,
              "autoscale": true,
              "requests": [
                {
                  "q": "avg:agriguard.command.ack_latency_ms.95percentile{*}",
                  "aggregator": "avg"
                }
              ],
              "custom_unit": "ms"
            }
          },
          {
            "definition": {
              "type": "manage_status",
              "title": "Monitors AgriGuard",
              "query": "tag:app:agriguard",
              "summary_type": "monitors",
              "display_format": "countsAndList",
              "sort": "status,asc",
              "color_preference": "text",
              "hide_zero_counts": true
            }
          }
        ]
      }
    },
    {
      "definition": {
        "type": "group",
        "title": "Cảm biến môi trường",
        "layout_type": "ordered",
        "widgets": [
          {
            "definition": {
              "type": "timeseries",
              "title": "Nhiệt độ không khí (°C)",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "q": "avg:agriguard.air.temperature{$device_id} by {device_id}",
                  "display_type": "line"
                }
              ]
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "Độ ẩm không khí (%)",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "q": "avg:agriguard.air.humidity{$device_id} by {device_id}",
                  "display_type": "line"
                }
              ]
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "Độ ẩm đất (%)",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "q": "avg:agriguard.soil.moisture{$device_id} by {device_id}",
                  "display_type": "line"
                }
              ]
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "Cảm biến hoạt động (1 = OK)",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "q": "min:agriguard.sensor.ok{$device_id} by {device_id,sensor}",
                  "display_type": "line"
                }
              ]
            }
          }
        ]
      }
    },
    {
      "definition": {
        "type": "group",
        "title": "Bơm, nước & phun sương",
        "layout_type": "ordered",
        "widgets": [
          {
            "definition": {
              "type": "timeseries",
              "title": "Trạng thái bơm (1 = chạy)",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "q": "max:agriguard.pump.state{$device_id} by {device_id}",
                  "display_type": "area"
                }
              ]
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "Lưu lượng nước (L/phút)",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "q": "avg:agriguard.flow.rate{$device_id} by {device_id}",
                  "display_type": "line"
                }
              ]
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "Trạng thái phun sương (1 = chạy)",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "q": "max:agriguard.mist.state{$device_id} by {device_id}",
                  "display_type": "area"
                }
              ]
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "Lỗi đang hoạt động theo loại",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "q": "max:agriguard.fault.active{$device_id} by {fault}",
                  "display_type": "bars",
                  "style": {
                    "palette": "warm"
                  }
                }
              ]
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "Quyết định điều khiển tự động",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "q": "sum:agriguard.control.decision{*} by {reason}.as_count()",
                  "display_type": "bars"
                }
              ]
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "Nước đã tưới (mL / khoảng)",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "q": "sum:agriguard.flow.volume_ml{$device_id} by {device_id}.as_count()",
                  "display_type": "bars"
                }
              ]
            }
          }
        ]
      }
    },
    {
      "definition": {
        "type": "group",
        "title": "Đường ống dữ liệu & điều khiển",
        "layout_type": "ordered",
        "widgets": [
          {
            "definition": {
              "type": "timeseries",
              "title": "Bản tin MQTT nhận được",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "q": "sum:agriguard.mqtt.messages_received{*} by {kind}.as_count()",
                  "display_type": "bars"
                }
              ]
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "Độ trễ ingest (ms) – p95 / trung bình",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "q": "avg:agriguard.ingest.latency_ms.95percentile{*}",
                  "display_type": "line"
                },
                {
                  "q": "avg:agriguard.ingest.latency_ms.avg{*}",
                  "display_type": "line"
                }
              ]
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "Thời gian ghi MongoDB (ms) – p95",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "q": "avg:agriguard.mongo.write_latency_ms.95percentile{*}",
                  "display_type": "line"
                }
              ]
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "Độ trễ xác nhận lệnh (ms) – p95",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "q": "avg:agriguard.command.ack_latency_ms.95percentile{*} by {device_id}",
                  "display_type": "line"
                }
              ]
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "Lệnh: gửi / xác nhận / quá hạn",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "q": "sum:agriguard.command.sent{*}.as_count()",
                  "display_type": "bars"
                },
                {
                  "q": "sum:agriguard.command.acked{*}.as_count()",
                  "display_type": "bars"
                },
                {
                  "q": "sum:agriguard.command.timeout{*}.as_count()",
                  "display_type": "bars"
                }
              ]
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "API backend – request & lỗi (APM)",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "q": "sum:trace.fastapi.request.hits{service:agriguard-backend}.as_count()",
                  "display_type": "bars"
                },
                {
                  "q": "sum:trace.fastapi.request.errors{service:agriguard-backend}.as_count()",
                  "display_type": "bars"
                }
              ]
            }
          }
        ]
      }
    },
    {
      "definition": {
        "type": "group",
        "title": "Phản hồi đất trên mỗi lít nước (phát hiện bất thường)",
        "layout_type": "ordered",
        "widgets": [
          {
            "definition": {
              "type": "timeseries",
              "title": "Phản hồi đất (%/L) từng lần tưới vs mức bình thường",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "q": "avg:agriguard.irrigation.response_pct_per_liter{$device_id} by {device_id}",
                  "display_type": "line"
                },
                {
                  "q": "avg:agriguard.irrigation.baseline_pct_per_liter{$device_id} by {device_id}",
                  "display_type": "line"
                }
              ]
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "Độ lệch so với bình thường (robust z-score)",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "q": "avg:agriguard.irrigation.response_zscore{$device_id} by {device_id}",
                  "display_type": "line"
                }
              ],
              "markers": [
                {
                  "value": "y = -3",
                  "display_type": "error dashed",
                  "label": "nước không tới gốc"
                },
                {
                  "value": "y = 3",
                  "display_type": "warning dashed",
                  "label": "đất ẩm lên quá nhanh"
                }
              ],
              "yaxis": {
                "min": "-8",
                "max": "8"
              }
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "Nước mỗi lần tưới (L)",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "q": "avg:agriguard.irrigation.liters{$device_id} by {device_id}",
                  "display_type": "bars"
                }
              ]
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "Lần tưới theo kết quả đánh giá",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "q": "sum:agriguard.irrigation.events{*} by {status}.as_count()",
                  "display_type": "bars"
                }
              ]
            }
          }
        ]
      }
    },
    {
      "definition": {
        "type": "group",
        "title": "Dự báo & phát hiện bất thường (Forecast · Prediction · Anomaly)",
        "layout_type": "ordered",
        "widgets": [
          {
            "definition": {
              "type": "timeseries",
              "title": "Độ ẩm đất + dự báo (forecast linear)",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "q": "avg:agriguard.soil.moisture{$device_id} by {device_id}",
                  "display_type": "line"
                },
                {
                  "q": "forecast(avg:agriguard.soil.moisture{$device_id} by {device_id}, 'linear', 1)",
                  "display_type": "line"
                }
              ]
            }
          },
          {
            "definition": {
              "type": "query_value",
              "title": "Đất khô tới ngưỡng tưới sau (phút)",
              "precision": 0,
              "autoscale": true,
              "requests": [
                {
                  "q": "min:agriguard.soil.minutes_to_dry{$device_id}",
                  "aggregator": "last"
                }
              ],
              "custom_unit": "phút"
            }
          },
          {
            "definition": {
              "type": "query_value",
              "title": "Dự báo nước cần mỗi ngày (L)",
              "precision": 1,
              "autoscale": true,
              "requests": [
                {
                  "q": "sum:agriguard.water.predicted_liters_per_day{$device_id}",
                  "aggregator": "last"
                }
              ],
              "custom_unit": "L"
            }
          },
          {
            "definition": {
              "type": "query_value",
              "title": "Nước cho lần tưới kế tiếp (L)",
              "precision": 2,
              "autoscale": true,
              "requests": [
                {
                  "q": "avg:agriguard.irrigation.predicted_liters_next{$device_id}",
                  "aggregator": "last"
                }
              ],
              "custom_unit": "L"
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "Nước tưới – dải bình thường (anomaly basic)",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "q": "anomalies(sum:agriguard.flow.volume_ml{$device_id}.as_count(), 'basic', 3)",
                  "display_type": "bars"
                }
              ]
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "Bộ nhớ trống ESP32 + dự báo",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "q": "min:agriguard.device.free_heap{$device_id} by {device_id}",
                  "display_type": "line"
                },
                {
                  "q": "forecast(min:agriguard.device.free_heap{$device_id} by {device_id}, 'linear', 1)",
                  "display_type": "line"
                }
              ]
            }
          }
        ]
      }
    },
    {
      "definition": {
        "type": "group",
        "title": "AI tưới – dự báo, lịch tưới & độ tin cậy mô hình",
        "layout_type": "ordered",
        "widgets": [
          {
            "definition": {
              "type": "timeseries",
              "title": "Độ ẩm đất thật vs AI dự báo (1 giờ / 6 giờ tới)",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "q": "avg:agriguard.soil.moisture{$device_id} by {device_id}",
                  "display_type": "line"
                },
                {
                  "q": "avg:agriguard.ai.soil_forecast_1h{$device_id} by {device_id}",
                  "display_type": "line"
                },
                {
                  "q": "avg:agriguard.ai.soil_forecast_6h{$device_id} by {device_id}",
                  "display_type": "line"
                }
              ]
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "Sai số dự báo 1 giờ (|thật − dự báo|, %) và MAE 24 giờ",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "q": "avg:agriguard.ml.forecast_error_abs{$device_id} by {method}",
                  "display_type": "line"
                },
                {
                  "q": "avg:agriguard.ml.forecast_mae{$device_id} by {device_id}",
                  "display_type": "line"
                }
              ]
            }
          },
          {
            "definition": {
              "type": "query_value",
              "title": "MAE kiểm định mô hình (%/giờ)",
              "precision": 2,
              "autoscale": true,
              "requests": [
                {
                  "q": "avg:agriguard.ml.model.validation_mae{$device_id}",
                  "aggregator": "last"
                }
              ]
            }
          },
          {
            "definition": {
              "type": "query_value",
              "title": "Kỹ năng so với trung bình (1 = hoàn hảo)",
              "precision": 2,
              "autoscale": true,
              "requests": [
                {
                  "q": "avg:agriguard.ml.model.skill{$device_id}",
                  "aggregator": "last"
                }
              ]
            }
          },
          {
            "definition": {
              "type": "query_value",
              "title": "Số mẫu huấn luyện",
              "precision": 0,
              "autoscale": true,
              "requests": [
                {
                  "q": "avg:agriguard.ml.model.samples{$device_id}",
                  "aggregator": "last"
                }
              ]
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "Số lần học lại theo nguồn kích hoạt",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "q": "sum:agriguard.ml.retrains{*} by {trigger}.as_count()",
                  "display_type": "bars"
                }
              ]
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "Lịch tưới AI: lít dự kiến & phút tới lần tưới",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "q": "avg:agriguard.ai.plan.liters{$device_id} by {device_id}",
                  "display_type": "line"
                },
                {
                  "q": "avg:agriguard.ai.plan.minutes_until{$device_id} by {device_id}",
                  "display_type": "line"
                }
              ]
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "Nguy cơ thiếu nước / stress nhiệt (0–1)",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "q": "max:agriguard.ai.risk.water_shortage{$device_id} by {device_id}",
                  "display_type": "line"
                },
                {
                  "q": "max:agriguard.ai.risk.heat_stress{$device_id} by {device_id}",
                  "display_type": "line"
                }
              ]
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "Quyết định của bộ điều khiển AI",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "q": "sum:agriguard.control.decision{actuator:pump} by {reason}.as_count()",
                  "display_type": "bars"
                }
              ]
            }
          }
        ]
      }
    },
    {
      "definition": {
        "type": "group",
        "title": "Chẩn đoán mất kết nối & bơm chạy khô",
        "layout_type": "ordered",
        "widgets": [
          {
            "definition": {
              "type": "toplist",
              "title": "Nguyên nhân mất kết nối",
              "requests": [
                {
                  "q": "top(sum:agriguard.device.reconnects{$device_id} by {cause}.as_count(), 10, 'sum', 'desc')"
                }
              ]
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "Thiết bị online & khởi động lại theo nguyên nhân",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "q": "min:agriguard.device.online{$device_id} by {device_id}",
                  "display_type": "line"
                },
                {
                  "q": "sum:agriguard.device.reboots{$device_id} by {reset_reason}.as_count()",
                  "display_type": "line"
                }
              ]
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "Thời gian mất kết nối (giây) theo nguyên nhân",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "q": "max:agriguard.device.disconnect_seconds.max{$device_id} by {cause}",
                  "display_type": "bars"
                }
              ]
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "RSSI hiện tại và RSSI ngay trước khi rớt (dBm)",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "q": "avg:agriguard.device.rssi{$device_id} by {device_id}",
                  "display_type": "line"
                },
                {
                  "q": "min:agriguard.device.rssi_before_drop{$device_id} by {device_id}",
                  "display_type": "line"
                }
              ]
            }
          },
          {
            "definition": {
              "type": "toplist",
              "title": "Nguyên nhân bơm chạy khô",
              "requests": [
                {
                  "q": "top(sum:agriguard.pump.dry_run_diagnosis{$device_id} by {cause}.as_count(), 10, 'sum', 'desc')"
                }
              ]
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "Thời gian mồi nước của bơm (ms)",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "q": "avg:agriguard.pump.prime_ms.avg{$device_id} by {device_id}",
                  "display_type": "line"
                }
              ]
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "Bơm bật vs lưu lượng",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "q": "max:agriguard.pump.state{$device_id} by {device_id}",
                  "display_type": "line"
                },
                {
                  "q": "avg:agriguard.flow.rate{$device_id} by {device_id}",
                  "display_type": "line"
                }
              ]
            }
          },
          {
            "definition": {
              "type": "log_stream",
              "title": "Mosquitto: ngắt kết nối thiết bị",
              "query": "service:agriguard-mqtt (\"exceeded timeout\" OR \"session taken over\" OR \"not authorised\")",
              "columns": [
                "service"
              ],
              "indexes": [],
              "message_display": "inline",
              "show_date_column": true,
              "show_message_column": true,
              "sort": {
                "column": "time",
                "order": "desc"
              }
            }
          },
          {
            "definition": {
              "type": "log_stream",
              "title": "Chẩn đoán từ thiết bị (nối lại / lần bơm)",
              "query": "service:agriguard-backend (\"Device reconnected\" OR \"Pump run diagnosis\")",
              "columns": [
                "service",
                "device_id",
                "cause"
              ],
              "indexes": [],
              "message_display": "expanded-md",
              "show_date_column": true,
              "show_message_column": true,
              "sort": {
                "column": "time",
                "order": "desc"
              }
            }
          }
        ]
      }
    },
    {
      "definition": {
        "type": "group",
        "title": "Sức khoẻ thiết bị",
        "layout_type": "ordered",
        "widgets": [
          {
            "definition": {
              "type": "timeseries",
              "title": "Wi‑Fi RSSI (dBm)",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "q": "avg:agriguard.device.rssi{$device_id} by {device_id}",
                  "display_type": "line"
                }
              ]
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "Uptime (giây) – rơi về 0 = khởi động lại",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "q": "max:agriguard.device.uptime{$device_id} by {device_id}",
                  "display_type": "line"
                }
              ]
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "Khởi động lại theo nguyên nhân",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "q": "sum:agriguard.device.reboots{*} by {reset_reason}.as_count()",
                  "display_type": "bars"
                }
              ]
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "Bộ nhớ trống ESP32 (byte)",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "q": "min:agriguard.device.free_heap{$device_id} by {device_id}",
                  "display_type": "line"
                }
              ]
            }
          }
        ]
      }
    },
    {
      "definition": {
        "type": "group",
        "title": "Sự cố (Detect – Investigate – Resolve)",
        "layout_type": "ordered",
        "widgets": [
          {
            "definition": {
              "type": "toplist",
              "title": "Sự cố đang mở theo loại",
              "requests": [
                {
                  "q": "top(max:agriguard.incident.open{*} by {type}, 10, 'last', 'desc')"
                }
              ]
            }
          },
          {
            "definition": {
              "type": "toplist",
              "title": "MTTR trung bình theo loại (giây)",
              "requests": [
                {
                  "q": "top(avg:agriguard.incident.mttr_seconds.avg{*} by {type}, 10, 'mean', 'desc')"
                }
              ]
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "Kiểm chứng bị từ chối (báo đã sửa khi chưa sửa)",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "q": "sum:agriguard.incident.verification_failed{*} by {type}.as_count()",
                  "display_type": "bars"
                }
              ]
            }
          },
          {
            "definition": {
              "type": "toplist",
              "title": "MTTD trung bình theo loại (giây)",
              "requests": [
                {
                  "q": "top(avg:agriguard.incident.mttd_seconds.avg{*} by {type}, 10, 'mean', 'desc')"
                }
              ]
            }
          },
          {
            "definition": {
              "type": "log_stream",
              "title": "Log cảnh báo & lỗi của backend",
              "query": "service:agriguard-backend status:(warn OR error)",
              "columns": [
                "service",
                "device_id",
                "incident_id"
              ],
              "indexes": [],
              "message_display": "expanded-md",
              "show_date_column": true,
              "show_message_column": true,
              "sort": {
                "column": "time",
                "order": "desc"
              }
            }
          }
        ]
      }
    }
  ]
}