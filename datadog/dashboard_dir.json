{
  "title": "AgriGuard – Detect · Investigate · Resolve",
  "description": "Dashboard demo theo kịch bản Detect – Investigate – Resolve (ESP32 → MQTT → FastAPI → MongoDB → Datadog). Monitor được phân vai bằng tag dir:detect / dir:investigate / dir:resolve và detect:now / detect:degrading / detect:early. Tạo bởi datadog/bootstrap.py – sửa trong definitions.py, không sửa tay.",
  "layout_type": "ordered",
  "template_variables": [
    {
      "name": "device_id",
      "prefix": "device_id",
      "default": "*"
    }
  ],
  "widgets": [
    {
      "definition": {
        "type": "group",
        "title": "1. Overview – Hệ thống có ổn không?",
        "layout_type": "ordered",
        "widgets": [
          {
            "definition": {
              "type": "query_value",
              "title": "Thiết bị online",
              "precision": 0,
              "autoscale": true,
              "requests": [
                {
                  "q": "sum:agriguard.device.online{*}",
                  "aggregator": "last"
                }
              ]
            }
          },
          {
            "definition": {
              "type": "query_value",
              "title": "Sự cố đang mở",
              "precision": 0,
              "autoscale": true,
              "requests": [
                {
                  "q": "sum:agriguard.incident.open{*}",
                  "aggregator": "last"
                }
              ]
            }
          },
          {
            "definition": {
              "type": "check_status",
              "title": "Backend API (http check)",
              "check": "http.can_connect",
              "grouping": "cluster",
              "tags": [
                "app:agriguard"
              ]
            }
          },
          {
            "definition": {
              "type": "check_status",
              "title": "Broker MQTT (tcp check)",
              "check": "tcp.can_connect",
              "grouping": "cluster",
              "tags": [
                "app:agriguard"
              ]
            }
          }
        ]
      }
    },
    {
      "definition": {
        "type": "group",
        "title": "2. Detect – Có gì bất thường?",
        "layout_type": "ordered",
        "widgets": [
          {
            "definition": {
              "type": "manage_status",
              "title": "Đang hỏng – xử lý ngay",
              "query": "tag:app:agriguard tag:\"detect:now\"",
              "summary_type": "monitors",
              "display_format": "countsAndList",
              "sort": "status,asc",
              "color_preference": "background",
              "hide_zero_counts": true
            }
          },
          {
            "definition": {
              "type": "manage_status",
              "title": "Đang suy giảm – còn chạy nhưng kém đi",
              "query": "tag:app:agriguard tag:\"detect:degrading\"",
              "summary_type": "monitors",
              "display_format": "countsAndList",
              "sort": "status,asc",
              "color_preference": "background",
              "hide_zero_counts": true
            }
          },
          {
            "definition": {
              "type": "manage_status",
              "title": "Sắp xảy ra – cảnh báo sớm",
              "query": "tag:app:agriguard tag:\"detect:early\"",
              "summary_type": "monitors",
              "display_format": "countsAndList",
              "sort": "status,asc",
              "color_preference": "background",
              "hide_zero_counts": true
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "Bơm (1 = chạy) vs lưu lượng (L/phút)",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "q": "max:agriguard.pump.state{$device_id} by {device_id}",
                  "display_type": "line"
                },
                {
                  "q": "avg:agriguard.flow.rate{$device_id} by {device_id}",
                  "display_type": "line"
                }
              ]
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "Lỗi đang hoạt động theo loại",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "q": "max:agriguard.fault.active{$device_id} by {fault}",
                  "display_type": "bars",
                  "style": {
                    "palette": "warm"
                  }
                }
              ]
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "Cảm biến hoạt động (1 = OK)",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "q": "min:agriguard.sensor.ok{$device_id} by {device_id,sensor}",
                  "display_type": "line"
                }
              ]
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "Độ ẩm đất + dự báo (forecast)",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "q": "avg:agriguard.soil.moisture{$device_id} by {device_id}",
                  "display_type": "line"
                },
                {
                  "q": "forecast(avg:agriguard.soil.moisture{$device_id} by {device_id}, 'linear', 1)",
                  "display_type": "line"
                }
              ]
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "Nước tưới – dải bình thường (anomaly)",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "q": "anomalies(sum:agriguard.flow.volume_ml{$device_id}.as_count(), 'basic', 3)",
                  "display_type": "bars"
                }
              ]
            }
          },
          {
            "definition": {
              "type": "query_value",
              "title": "Nguy cơ thiếu nước 6 giờ tới (0–1)",
              "precision": 2,
              "autoscale": false,
              "requests": [
                {
                  "q": "max:agriguard.ai.risk.water_shortage{$device_id}",
                  "aggregator": "max",
                  "conditional_formats": [
                    {
                      "comparator": ">=",
                      "value": 0.7,
                      "palette": "white_on_red"
                    },
                    {
                      "comparator": ">=",
                      "value": 0.4,
                      "palette": "white_on_yellow"
                    },
                    {
                      "comparator": "<",
                      "value": 0.4,
                      "palette": "white_on_green"
                    }
                  ]
                }
              ]
            }
          },
          {
            "definition": {
              "type": "query_value",
              "title": "Nguy cơ stress nhiệt 6 giờ tới (0–1)",
              "precision": 2,
              "autoscale": false,
              "requests": [
                {
                  "q": "max:agriguard.ai.risk.heat_stress{$device_id}",
                  "aggregator": "max",
                  "conditional_formats": [
                    {
                      "comparator": ">=",
                      "value": 0.7,
                      "palette": "white_on_red"
                    },
                    {
                      "comparator": ">=",
                      "value": 0.4,
                      "palette": "white_on_yellow"
                    },
                    {
                      "comparator": "<",
                      "value": 0.4,
                      "palette": "white_on_green"
                    }
                  ]
                }
              ]
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "Phản hồi đất/lít – độ lệch so với bình thường (z-score)",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "q": "avg:agriguard.irrigation.response_zscore{$device_id} by {device_id}",
                  "display_type": "line"
                }
              ],
              "markers": [
                {
                  "value": "y = -3",
                  "display_type": "error dashed",
                  "label": "nước không tới gốc"
                },
                {
                  "value": "y = 3",
                  "display_type": "warning dashed",
                  "label": "đất ẩm lên quá nhanh"
                }
              ],
              "yaxis": {
                "min": "-8",
                "max": "8"
              }
            }
          }
        ]
      }
    },
    {
      "definition": {
        "type": "group",
        "title": "3. Investigate – Vì sao xảy ra?",
        "layout_type": "ordered",
        "widgets": [
          {
            "definition": {
              "type": "manage_status",
              "title": "Monitor chỉ ra nguyên nhân",
              "query": "tag:app:agriguard tag:\"dir:investigate\"",
              "summary_type": "monitors",
              "display_format": "countsAndList",
              "sort": "status,asc",
              "color_preference": "background",
              "hide_zero_counts": true
            }
          },
          {
            "definition": {
              "type": "toplist",
              "title": "Nguyên nhân mất kết nối",
              "requests": [
                {
                  "q": "top(sum:agriguard.device.reconnects{$device_id} by {cause}.as_count(), 10, 'sum', 'desc')"
                }
              ]
            }
          },
          {
            "definition": {
              "type": "toplist",
              "title": "Nguyên nhân bơm chạy khô",
              "requests": [
                {
                  "q": "top(sum:agriguard.pump.dry_run_diagnosis{$device_id} by {cause}.as_count(), 10, 'sum', 'desc')"
                }
              ]
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "Thiết bị online & khởi động lại theo nguyên nhân",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "q": "min:agriguard.device.online{$device_id} by {device_id}",
                  "display_type": "line"
                },
                {
                  "q": "sum:agriguard.device.reboots{$device_id} by {reset_reason}.as_count()",
                  "display_type": "line"
                }
              ]
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "Thời gian mất kết nối (giây) theo nguyên nhân",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "q": "max:agriguard.device.disconnect_seconds.max{$device_id} by {cause}",
                  "display_type": "bars"
                }
              ]
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "RSSI hiện tại và ngay trước khi rớt (dBm)",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "q": "avg:agriguard.device.rssi{$device_id} by {device_id}",
                  "display_type": "line"
                },
                {
                  "q": "min:agriguard.device.rssi_before_drop{$device_id} by {device_id}",
                  "display_type": "line"
                }
              ]
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "Thời gian mồi nước của bơm (ms)",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "q": "avg:agriguard.pump.prime_ms.avg{$device_id} by {device_id}",
                  "display_type": "line"
                }
              ]
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "Phản hồi đất (%/L) từng lần tưới vs mức bình thường",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "q": "avg:agriguard.irrigation.response_pct_per_liter{$device_id} by {device_id}",
                  "display_type": "line"
                },
                {
                  "q": "avg:agriguard.irrigation.baseline_pct_per_liter{$device_id} by {device_id}",
                  "display_type": "line"
                }
              ]
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "Độ trễ ingest & ghi MongoDB p95 (ms)",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "q": "avg:agriguard.ingest.latency_ms.95percentile{*}",
                  "display_type": "line"
                },
                {
                  "q": "avg:agriguard.mongo.write_latency_ms.95percentile{*}",
                  "display_type": "line"
                }
              ]
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "Lệnh: gửi / xác nhận / quá hạn",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "q": "sum:agriguard.command.sent{*}.as_count()",
                  "display_type": "bars"
                },
                {
                  "q": "sum:agriguard.command.acked{*}.as_count()",
                  "display_type": "bars"
                },
                {
                  "q": "sum:agriguard.command.timeout{*}.as_count()",
                  "display_type": "bars"
                }
              ]
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "API backend – request & lỗi (APM)",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "q": "sum:trace.fastapi.request.hits{service:agriguard-backend}.as_count()",
                  "display_type": "bars"
                },
                {
                  "q": "sum:trace.fastapi.request.errors{service:agriguard-backend}.as_count()",
                  "display_type": "bars"
                }
              ]
            }
          },
          {
            "definition": {
              "type": "log_stream",
              "title": "Mosquitto: ngắt kết nối thiết bị",
              "query": "service:agriguard-mqtt (\"exceeded timeout\" OR \"session taken over\" OR \"not authorised\")",
              "columns": [
                "service"
              ],
              "indexes": [],
              "message_display": "expanded-md",
              "show_date_column": true,
              "show_message_column": true,
              "sort": {
                "column": "time",
                "order": "desc"
              }
            }
          },
          {
            "definition": {
              "type": "log_stream",
              "title": "Chẩn đoán từ thiết bị (nối lại / lần bơm)",
              "query": "service:agriguard-backend (\"Device reconnected\" OR \"Pump run diagnosis\")",
              "columns": [
                "service",
                "device_id",
                "cause"
              ],
              "indexes": [],
              "message_display": "expanded-md",
              "show_date_column": true,
              "show_message_column": true,
              "sort": {
                "column": "time",
                "order": "desc"
              }
            }
          },
          {
            "definition": {
              "type": "log_stream",
              "title": "Log cảnh báo & lỗi backend (mở dòng log → tab Trace)",
              "query": "service:agriguard-backend status:(warn OR error)",
              "columns": [
                "service",
                "device_id",
                "incident_id"
              ],
              "indexes": [],
              "message_display": "expanded-md",
              "show_date_column": true,
              "show_message_column": true,
              "sort": {
                "column": "time",
                "order": "desc"
              }
            }
          }
        ]
      }
    },
    {
      "definition": {
        "type": "group",
        "title": "4. Resolve – Đã khắc phục chưa, mất bao lâu?",
        "layout_type": "ordered",
        "widgets": [
          {
            "definition": {
              "type": "manage_status",
              "title": "Chất lượng khắc phục",
              "query": "tag:app:agriguard tag:\"dir:resolve\"",
              "summary_type": "monitors",
              "display_format": "countsAndList",
              "sort": "status,asc",
              "color_preference": "background",
              "hide_zero_counts": true
            }
          },
          {
            "definition": {
              "type": "toplist",
              "title": "Sự cố đang mở theo loại",
              "requests": [
                {
                  "q": "top(max:agriguard.incident.open{*} by {type}, 10, 'last', 'desc')"
                }
              ]
            }
          },
          {
            "definition": {
              "type": "toplist",
              "title": "MTTD trung bình theo loại (giây)",
              "requests": [
                {
                  "q": "top(avg:agriguard.incident.mttd_seconds.avg{*} by {type}, 10, 'mean', 'desc')"
                }
              ]
            }
          },
          {
            "definition": {
              "type": "toplist",
              "title": "MTTR trung bình theo loại (giây)",
              "requests": [
                {
                  "q": "top(avg:agriguard.incident.mttr_seconds.avg{*} by {type}, 10, 'mean', 'desc')"
                }
              ]
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "Sự cố mở vs đóng",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "q": "sum:agriguard.incident.opened{*}.as_count()",
                  "display_type": "bars"
                },
                {
                  "q": "sum:agriguard.incident.resolved{*}.as_count()",
                  "display_type": "bars"
                }
              ]
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "Kiểm chứng thất bại (từ chối đóng khi chưa sửa)",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "q": "sum:agriguard.incident.verification_failed{*} by {type}.as_count()",
                  "display_type": "bars"
                }
              ]
            }
          }
        ]
      }
    },
    {
      "definition": {
        "type": "group",
        "title": "5. Môi trường",
        "layout_type": "ordered",
        "widgets": [
          {
            "definition": {
              "type": "timeseries",
              "title": "Nhiệt độ không khí (°C)",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "q": "avg:agriguard.air.temperature{$device_id} by {device_id}",
                  "display_type": "line"
                }
              ]
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "Độ ẩm không khí (%)",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "q": "avg:agriguard.air.humidity{$device_id} by {device_id}",
                  "display_type": "line"
                }
              ]
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "Độ ẩm đất (%)",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "q": "avg:agriguard.soil.moisture{$device_id} by {device_id}",
                  "display_type": "line"
                }
              ]
            }
          }
        ]
      }
    }
  ]
}